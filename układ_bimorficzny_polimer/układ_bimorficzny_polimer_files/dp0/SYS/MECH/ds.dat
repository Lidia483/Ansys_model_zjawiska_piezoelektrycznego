/com,--- Number of total elements = %_numelem%
*get,_wallbsol,active,,time,wall
/solu
antype,2                   ! modal analysis
_thickRatio=0.25    ! Ratio of thick parts in the model
thexpand,off     ! ignore thermal strains
modopt,lanb,3
outres,erase
